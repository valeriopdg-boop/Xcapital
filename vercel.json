{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "redirects": [
    { "source": "/services/", "destination": "/servizi/", "statusCode": 301 },
    { "source": "/ma-advisory/", "destination": "/servizi/fusioni-acquisizioni/", "statusCode": 301 },
    { "source": "/corporate-finance/", "destination": "/servizi/finanza-raccolta-capitali/", "statusCode": 301 },
    { "source": "/real-estate/", "destination": "/servizi/immobiliare/", "statusCode": 301 },
    { "source": "/energy-infrastructure/", "destination": "/servizi/energia-infrastrutture/", "statusCode": 301 },
    { "source": "/strategic-advisory/", "destination": "/servizi/advisory-strategico/", "statusCode": 301 },
    { "source": "/growth-venture/", "destination": "/servizi/crescita-startup/", "statusCode": 301 },
    { "source": "/insight/", "destination": "/risorse/", "statusCode": 301 },
    { "source": "/insight/2024-11-15-adattamento-analisi-startup/", "destination": "/risorse/approfondimenti/adattamento-analisi-startup/", "statusCode": 301 },
    { "source": "/insight/2024-09-25-safe-per-pmi-innovative/", "destination": "/risorse/approfondimenti/safe-per-pmi-innovative/", "statusCode": 301 },
    { "source": "/education/", "destination": "/risorse/", "statusCode": 301 },
    { "source": "/category/press/", "destination": "/risorse/", "statusCode": 301 },
    { "source": "/webinar/", "destination": "/risorse/", "statusCode": 301 },
    { "source": "/track-record/industrial-sell-side/", "destination": "/track-record/", "statusCode": 301 },
    { "source": "/track-record/strategic-buy-side/", "destination": "/track-record/", "statusCode": 301 },
    { "source": "/track-record/hospitality-asset-sale/", "destination": "/track-record/", "statusCode": 301 },
    { "source": "/track-record/energy-project-financing/", "destination": "/track-record/", "statusCode": 301 },
    { "source": "/track-record/growth-capital-round/", "destination": "/track-record/", "statusCode": 301 },
    { "source": "/track-record/iride-acque-secondo-round/", "destination": "/track-record/iride-acque-2-round/", "statusCode": 301 },
    { "source": "/track-record/iride-acque-primo-round/", "destination": "/track-record/iride-acque-1-round/", "statusCode": 301 },
    { "source": "/track-record/socopet-terzo-round/", "destination": "/track-record/socopet-3-round/", "statusCode": 301 },
    { "source": "/track-record/socopet-secondo-round/", "destination": "/track-record/socopet-2-round/", "statusCode": 301 },
    { "source": "/track-record/wearena-secondo-round/", "destination": "/track-record/wearena-2-round/", "statusCode": 301 },
    { "source": "/track-record/royal-primo-round/", "destination": "/track-record/royal-1-round/", "statusCode": 301 },
    { "source": "/track-record/ellemme-minibond-uno/", "destination": "/track-record/ellemme-minibond-1-milione/", "statusCode": 301 },
    { "source": "/track-record/ellemme-minibond-cinque/", "destination": "/track-record/ellemme-minibond-5-milioni/", "statusCode": 301 },
    { "source": "/growth/(.*)", "destination": "/servizi/", "statusCode": 301 },
    { "source": "/advisory/", "destination": "/servizi/advisory-strategico/", "statusCode": 301 },
    { "source": "/finanza/", "destination": "/servizi/finanza-raccolta-capitali/", "statusCode": 301 },
    { "source": "/business-development/(.*)", "destination": "/servizi/", "statusCode": 301 },
    { "source": "/coaching-benessere/(.*)", "destination": "/servizi/", "statusCode": 301 }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|admin/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
